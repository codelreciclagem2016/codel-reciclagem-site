{%- from "icones.njk" import icone -%}
{%- set ctaContato = empresa[contato] if contato else empresa -%}
<section class="cta-final secao-verde">
  <div class="wrap">
    <h2>{{ ctaTitulo or "Ficou alguma dúvida?" }}</h2>
    <p>{{ ctaTexto or "Fale com a nossa equipe pelo WhatsApp. Respondemos em horário comercial." }}</p>
    <div class="botoes">
      <a class="btn btn-branco" href="{{ (whatsMensagem or empresa.whatsappMensagem) | whats(ctaContato.whatsapp) }}" target="_blank" rel="noopener">{{ icone("whatsapp") }} Chamar no WhatsApp</a>
      <a class="btn btn-contorno" href="tel:{{ ctaContato.telefoneE164 }}" data-evento="clique_telefone">{{ icone("telefone") }} {{ ctaContato.telefone }}</a>
    </div>
  </div>
</section>
